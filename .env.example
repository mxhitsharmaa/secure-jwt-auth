APP_NAME="Secure JWT Auth"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/secure-jwt-auth

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=auth
DB_USERNAME=root
DB_PASSWORD=

JWT_ISSUER=secure-jwt-auth
JWT_AUDIENCE=secure-jwt-users
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Secure JWT Auth"

OTP_EXPIRY=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

CORS_ALLOWED_ORIGINS=http://localhost